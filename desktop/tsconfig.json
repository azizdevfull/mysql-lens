{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "mysql2": ["../node_modules/mysql2"],
      "ssh2": ["../node_modules/@types/ssh2"],
      "exceljs": ["../node_modules/exceljs"],
      "csv-parse": ["../node_modules/csv-parse"]
    }
  },
  "include": ["main/**/*.ts", "renderer/**/*.ts", "shared/**/*.ts"]
}
