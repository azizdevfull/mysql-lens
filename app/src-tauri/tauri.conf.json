{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MySQL Lens",
  "version": "0.3.1",
  "identifier": "uz.azizdev.mysqllens",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5180",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Azizbek Isroilov",
    "shortDescription": "MySQL Lens",
    "longDescription": "Fast, lightweight MySQL and MariaDB client with unlimited connections.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlDQ0EwRjc3QTY0NDM4RjUKUldUMU9FU21kdy9LbkozN1NPT0g4RXNoNE9DelU5ODd4KzNjSlNrZUo3UzhhSzJMcTkyWDh6ZFIK",
      "endpoints": [
        "https://github.com/azizdevfull/mysql-lens/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
