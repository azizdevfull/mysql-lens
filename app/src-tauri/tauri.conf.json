{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MySQL Lens",
  "version": "0.2.0",
  "identifier": "uz.azizdev.mysqllens",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5180",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "MySQL Lens",
        "width": 1400,
        "height": 880,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "publisher": "Azizbek Isroilov",
    "shortDescription": "MySQL Lens",
    "longDescription": "Fast, lightweight MySQL and MariaDB client with unlimited connections.",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": false }
    }
  }
}
